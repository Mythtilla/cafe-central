# Café Central — environment
# Copy to .env and fill in. Never commit .env.
#
# The app does not read .env by itself; the npm scripts pass --env-file=.env.
# For Docker, pass the file with `docker run --env-file .env`.
#
# All the values below are provided automatically on Antideploy. They are only
# needed when you run the app locally or on your own server.

# ---- server ----
PORT=3000
# Bind address. Use 127.0.0.1 behind a reverse proxy; 0.0.0.0 in a container.
HOST=0.0.0.0

# ---- database ----
# Postgres connection string. This is the only source of truth for the
# connection: the pool parses it and ignores ambient PGHOST/PGPORT/... vars.
# Keep sslmode=require for managed providers (Neon, Supabase, RDS).
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# Optional: connection pool size (default 5).
# PG_POOL_MAX=5

# ---- image storage ----
# A private S3-compatible bucket. Uploaded photos go here and are streamed back
# through /uploads/<name>. BUCKET_NAME is the preferred name; the aliases below
# are accepted because hosting platforms each use a different spelling.
BUCKET_NAME=
AWS_REGION=auto
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# The bucket name contains a dot, so path-style addressing is required.
AWS_S3_FORCE_PATH_STYLE=true

# ---- admin bootstrap ----
# Created on first run only. If ADMIN_PASSWORD is omitted, a random password is
# generated and printed once to the console.
# Changing these later does NOT change an existing password: use /admin →
# Definições → password, or delete the row from the admins table.
ADMIN_USER=admin
ADMIN_PASSWORD=

# ---- sessions ----
# 32+ random bytes, hex. Generate: openssl rand -hex 32
# If omitted, one is generated once and stored in $DATA_DIR/.session-secret —
# which is lost on every container deploy, logging everyone out. Set it in
# production.
SESSION_SECRET=

# ---- cors ----
# Comma-separated origins allowed to call the PUBLIC API from a browser.
# Same-origin requests are always allowed. Never add admin origins here.
ALLOWED_ORIGIN=https://cafecentral.antideploy.app

# ---- proxy ----
# Set to 1 when running behind nginx/Caddy/a PaaS so the client IP comes from
# X-Forwarded-For. Leave 0 when the server is exposed directly, or clients can
# spoof their IP and dodge the rate limits.
TRUST_PROXY=0

# ---- optional: Google reviews (Phase 5) ----
# Both must be set to enable GET /api/google-reviews. Server-side only.
GOOGLE_PLACES_KEY=
GOOGLE_PLACE_ID=

{
  "name": "cafe-central",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "Café Central, Viseu — public site + admin panel",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --no-warnings server/index.js",
    "dev": "node --no-warnings --env-file=.env --watch server/index.js",
    "test": "node --no-warnings --env-file=.env --test tests/*.test.js",
    "seed:demo": "node --no-warnings --env-file=.env server/seed-demo.js",
    "build": "python3 build.py"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1159.0",
    "pg": "^8.23.1"
  }
}

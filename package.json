{
  "name": "cafe-central",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Caf\u00e9 Central, Viseu \u2014 public site + admin panel (zero runtime dependencies)",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --no-warnings server/index.js",
    "dev": "node --no-warnings --watch server/index.js",
    "test": "node --no-warnings --test tests/*.test.js",
    "seed:demo": "node --no-warnings server/seed-demo.js",
    "build": "python3 build.py"
  }
}
